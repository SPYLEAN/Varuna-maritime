# VARUNA — Environment Configuration Template
# Copy to .env for local runtime overrides. Never commit real credentials!

# Data & Research Directory Roots
VARUNA_DATA_ROOT=./data
VARUNA_RESEARCH_ROOT=./data/research

# Server & API Configuration
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Copernicus Data Space Ecosystem (CDSE) STAC Discovery & Product Acquisition
VARUNA_CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1/

# Copernicus Data Space Ecosystem (CDSE) Credentials
# Required for live Sentinel-1 SAFE archive download from CDSE OData API.
CDSE_USER=
CDSE_PASS=
